+        }
+    };
+    let overrides =
+        |text: &str| snippets::apply_cleanup_instruction_overrides(text, ctx.user_overrides);
+    let fallback = || {
+        (
+            overrides(&normalize(&prepared.text)),
+            String::new(),
+            String::new(),
