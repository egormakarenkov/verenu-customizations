+            if let Some(text) =
+                fidelity::validate(&prepared.text, &entry.clean_text, ctx.protected_terms)
+            {
+                cache::touch_cleanup_cache_hit(ctx.db, &key, &entry);
+                record_lookup(true);
+                return (overrides(&text), key, format!("local/{}", ctx.model));
+            }
+            let _ = db::cleanup_cache_delete_by_key(ctx.db, &key);
+            log::warn!("pipeline: fidelity rejected cached edits");
+        }
+        record_lookup(false);
+    }
+    let custom_template = ctx.cfg.cleanup_override(ctx.profile);
+    let mut prompt = prompts::get_cleanup_prompt_with_alternate_and_evidence(
+        "local",
+        ctx.model,
+        ctx.profile,
+        "light",
+        ctx.user_overrides,
+        ctx.evidence,
+        ctx.app_context,
+        &prepared.text,
+        custom_template.as_deref(),
+        None,
+    );
+    prompt.push_str("\n\nSpoken formatting and supported corrections have already been processed. Preserve the resulting symbols, identifiers, line breaks, and all remaining words. Output only the text with punctuation and capitalization edits.");
+    let started = std::time::Instant::now();
+    let outcome = async {
+        #[cfg(any(test, debug_assertions))]
+        if let Some(result) =
+            crate::testing::resolve_provider_fixture("cleanup", "local", ctx.model)
+        {
+            return result;
+        }
+        let app = ctx
+            .app
+            .ok_or_else(|| anyhow::anyhow!("Local cleanup runtime unavailable"))?;
+        app.state::<crate::local_llm::LocalLlmManager>()
+            .inner()
+            .clone()
+            .cleanup_once_with_prompt(
+                app,
+                ctx.model,
+                &prepared.text,
+                &prompt,
+                prompts::cleanup_max_output_tokens("light", &prepared.text),
+            )
+            .await
+    }
+    .await;
+    record_provider_duration(started.elapsed());
+    let cleaned = match outcome {
+        Ok(text) => text,
+        Err(_) => {
+            log::warn!("pipeline: fidelity local request failed, preserving transcript without model escalation");
+            return fallback();
+        }
+    };
+    let Some(validated) = fidelity::validate(&prepared.text, &cleaned, ctx.protected_terms) else {
+        log::warn!("pipeline: fidelity rejected unsupported model edits without retry");
+        return fallback();
+    };
+    let normalized = normalize(&validated);
+    let Some(validated) = fidelity::validate(&prepared.text, &normalized, ctx.protected_terms)
+    else {
+        log::warn!("pipeline: fidelity rejected postprocessing edits");
+        return fallback();
+    };
+    if !key.is_empty() {
+        let expires = sqlite_utc_plus(db::CLEANUP_CACHE_IDLE_DAYS);
+        let _ = db::cleanup_cache_insert_if(
+            ctx.db,
+            &key,
+            &validated,
+            &expires,
+            plan.has_snippets,
+            || {
+                ctx.app.map_or(ctx.cfg.cleanup_cache_enabled, |app| {
+                    store::settings_handle(app).is_ok_and(|settings| {
+                        settings
+                            .get(store::CLEANUP_CACHE_ENABLED)
+                            .and_then(|value| value.as_bool())
+                            .unwrap_or(true)
+                    })
+                })
+            },
+        );
+    }
+    (overrides(&validated), key, format!("local/{}", ctx.model))
+}
