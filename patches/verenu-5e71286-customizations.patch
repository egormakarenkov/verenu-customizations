+struct FidelityCleanup<'a> {
+    db: &'a DbHandle,
+    input: &'a str,
+    cfg: &'a store::PipelineConfig,
+    profile: &'a str,
+    model: &'a str,
+    user_overrides: &'a str,
+    evidence: &'a str,
+    app_context: Option<&'a str>,
+    app: Option<&'a AppHandle>,
+    context_id: i64,
+    protected_terms: &'a [&'a str],
+    skip_model: bool,
+    allow_cache: bool,
