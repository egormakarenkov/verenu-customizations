diff --git a/src-tauri/src/system/model_residency.rs b/src-tauri/src/system/model_residency.rs
new file mode 100644
index 0000000..ac02b24
--- /dev/null
+++ b/src-tauri/src/system/model_residency.rs
@@ -0,0 +1,99 @@
+//! Warm only downloaded default models, without running inference or downloads.
+use super::{
+    memory,
+    residency_policy::{has_headroom, WarmupSchedule},
+};
+use crate::{
+    data::store, local_llm::LocalLlmManager, local_stt::LocalTranscriptionManager,
+    pipeline::SharedState,
+};
+use std::sync::atomic::Ordering;
+use tauri::AppHandle;
+
+fn idle(state: &SharedState) -> bool {
+    state.lock().is_ok_and(|state| state.lifecycle.is_idle())
+}
+
+fn headroom(model_mb: u64) -> bool {
+    memory::system_memory_status()
+        .is_some_and(|mem| has_headroom(mem.available_mb, mem.total_mb, model_mb))
+}
+
+pub async fn maintain(
+    app: &AppHandle,
+    state: &SharedState,
+    stt: &LocalTranscriptionManager,
+    llm: &LocalLlmManager,
+    schedule: &mut WarmupSchedule,
+    now_ms: u64,
+    healthy: bool,
+) -> anyhow::Result<()> {
+    let settings = store::settings_snapshot(app).map_err(anyhow::Error::msg)?;
+    let cfg = store::load_pipeline_config(&settings);
+    if !schedule.ready(
+        now_ms,
+        healthy,
+        cfg.local_model_memory_policy == "keep_loaded",
+        idle(state),
+    ) {
+        return Ok(());
+    }
+    if stt.shutdown_signal.load(Ordering::Relaxed) || llm.shutdown_signal.load(Ordering::Relaxed) {
+        return Ok(());
+    }
+
+    let stt_model = store::parse_model_id(&cfg.transcription_default_model)
+        .filter(|(provider, _)| provider == store::LOCAL);
+    let llm_model = store::parse_model_id(&cfg.cleanup_default_model)
+        .filter(|(provider, _)| cfg.cleanup_enabled && provider == store::LOCAL);
+    let mut attempted = false;
+    if let Some((_, model)) = stt_model {
+        let manifest = crate::local_stt::model::manifest_by_id(&model);
+        if let Some(manifest) = manifest {
+            let root = stt.prepare_models_dir()?;
+            if !stt.state().is_loaded && manifest.is_downloaded(&root) && headroom(manifest.size_mb)
+            {
+                attempted = true;
+                schedule.attempted(now_ms);
+                let manager = stt.clone();
+                let app = app.clone();
+                log::info!("local models: background speech preload id={model}");
+                tokio::task::spawn_blocking(move || manager.preload_if_idle(&app, &model))
+                    .await??;
+            }
+        }
+    }
+    // Recheck after speech loading: it may have consumed the spare memory,
+    // or dictation/shutdown may have started while the engine initialized.
+    if !idle(state) || llm.shutdown_signal.load(Ordering::Relaxed) {
+        return Ok(());
+    }
+    if let Some((_, model)) = llm_model {
+        if let Some(manifest) = crate::local_llm::model::manifest_by_id(&model) {
+            let root = llm.prepare_models_dir()?;
+            let runtime_installed = std::env::var_os("VERENU_LLAMA_SERVER_PATH")
+                .map(std::path::PathBuf::from)
+                .is_some_and(|path| path.is_file())
+                || crate::local_llm::binary::is_runtime_installed(
+                    &crate::local_llm::binary::runtime_root(),
+                );
+            if !llm.state().is_loaded
+                && runtime_installed
+                && manifest.is_downloaded(&root)
+                && headroom(manifest.size_mb)
+            {
+                let safe = tokio::task::spawn_blocking(memory::detect_resource_pressure)
+                    .await?
+                    .is_none();
+                if safe && idle(state) {
+                    if !attempted {
+                        schedule.attempted(now_ms);
+                    }
+                    log::info!("local models: background cleanup preload id={model}");
+                    llm.preload_if_idle(app, &model).await?;
+                }
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/src-tauri/src/system/residency_policy.rs b/src-tauri/src/system/residency_policy.rs
new file mode 100644
index 0000000..89ec4c9
--- /dev/null
+++ b/src-tauri/src/system/residency_policy.rs
@@ -0,0 +1,80 @@
+//! Pure scheduling rules for optional background model loading.
+const RECOVERY_MS: u64 = 30_000;
+const RETRY_MS: u64 = 120_000;
+
+#[derive(Default)]
+pub struct WarmupSchedule {
+    healthy_since: Option<u64>,
+    recovering: bool,
+    next_attempt: u64,
+}
+
+impl WarmupSchedule {
+    pub fn ready(&mut self, now: u64, healthy: bool, enabled: bool, idle: bool) -> bool {
+        if !healthy {
+            self.healthy_since = None;
+            self.recovering = true;
+            self.next_attempt = now.saturating_add(RETRY_MS);
+            return false;
+        }
+        let since = *self.healthy_since.get_or_insert(now);
+        enabled
+            && idle
+            && now >= self.next_attempt
+            && (!self.recovering || now.saturating_sub(since) >= RECOVERY_MS)
+    }
+
+    pub fn attempted(&mut self, now: u64) {
+        self.next_attempt = now.saturating_add(RETRY_MS);
+    }
+}
+
+/// Reserve working memory beyond the weights, plus at least 2 GiB/12% for
+/// the rest of the system. Unknown memory status must not trigger a preload.
+pub fn has_headroom(available_mb: u64, total_mb: u64, model_mb: u64) -> bool {
+    total_mb > 0
+        && available_mb.saturating_sub(model_mb.saturating_add(512))
+            >= 2048.max(total_mb.saturating_mul(12) / 100)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn startup_preloads_but_busy_and_disabled_do_not() {
+        let mut schedule = WarmupSchedule::default();
+        assert!(!schedule.ready(5_000, true, false, true));
+        assert!(!schedule.ready(5_000, true, true, false));
+        assert!(schedule.ready(5_000, true, true, true));
+    }
+
+    #[test]
+    fn pressure_recovery_requires_stability_and_cooldown() {
+        let mut schedule = WarmupSchedule::default();
+        assert!(!schedule.ready(10_000, false, true, true));
+        assert!(!schedule.ready(100_000, true, true, true));
+        assert!(!schedule.ready(129_999, true, true, true));
+        assert!(schedule.ready(130_000, true, true, true));
+        assert!(!schedule.ready(140_000, false, true, true));
+        assert!(!schedule.ready(260_000, true, true, true));
+        assert!(schedule.ready(290_000, true, true, true));
+    }
+
+    #[test]
+    fn failed_or_successful_attempts_are_rate_limited() {
+        let mut schedule = WarmupSchedule::default();
+        schedule.attempted(5_000);
+        assert!(!schedule.ready(124_999, true, true, true));
+        assert!(schedule.ready(125_000, true, true, true));
+    }
+
+    #[test]
+    fn preload_reserves_space_for_weights_runtime_and_other_apps() {
+        assert!(has_headroom(8_000, 16_072, 2_100));
+        assert!(!has_headroom(3_000, 16_072, 2_100));
+        assert!(!has_headroom(274, 16_072, 478));
+        assert!(!has_headroom(8_000, 0, 478));
+        assert!(!has_headroom(5_000, 64_000, 478));
+    }
+}
