+    #[test]
+    fn keep_loaded_retains_under_ordinary_pressure_but_releases_for_emergencies() {
+        assert!(!should_unload_for_pressure_policy(
+            false,
+            Duration::from_secs(3600),
+            false,
+            true
+        ));
+        assert!(should_unload_for_pressure_policy(
+            true,
+            Duration::ZERO,
+            false,
+            true
+        ));
+        assert!(!should_unload_for_pressure_policy(
+            true,
+            Duration::ZERO,
+            true,
+            true
+        ));
+        assert!(should_unload_for_pressure_policy(
+            false,
+            Duration::from_secs(60),
+            false,
+            false
+        ));
+    }
+
+    #[test]
+    fn ordinary_pressure_preserves_recent_dictation_but_releases_idle_models() {
+        assert!(!should_unload_for_pressure(
+            false,
+            Duration::from_secs(5),
+            false
+        ));
+        assert!(!should_unload_for_pressure(
+            false,
+            Duration::from_secs(59),
+            false
+        ));
+        assert!(should_unload_for_pressure(
+            false,
+            Duration::from_secs(60),
+            false
+        ));
+    }
+
+    #[test]
+    fn critical_pressure_reclaims_recent_idle_models_without_interrupting_work() {
+        assert!(should_unload_for_pressure(true, Duration::ZERO, false));
+        for critical in [false, true] {
+            assert!(!should_unload_for_pressure(
+                critical,
+                Duration::from_secs(300),
+                true
+            ));
+        }
+    }
+
