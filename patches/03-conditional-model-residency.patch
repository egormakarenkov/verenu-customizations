+/// Critical pressure must reclaim idle models immediately; ordinary RAM
+/// pressure can briefly retain a model that the user is repeatedly using.
+pub struct ResourcePressure {
+    pub reason: String,
+    pub critical: bool,
+}
+
+pub fn should_unload_for_pressure(critical: bool, idle_for: Duration, busy: bool) -> bool {
+    !busy && (critical || idle_for >= Duration::from_secs(60))
+}
+
+pub fn should_unload_for_pressure_policy(
+    critical: bool,
+    idle_for: Duration,
+    busy: bool,
+    keep_loaded: bool,
+) -> bool {
+    (!keep_loaded || critical) && should_unload_for_pressure(critical, idle_for, busy)
+}
+
+fn ram_pressure(mem: SystemMemoryStatus) -> Option<ResourcePressure> {
+    (mem.available_mb < LOW_RAM_THRESHOLD_MB || mem.load_percent >= HIGH_RAM_LOAD_PERCENT).then(
+        || ResourcePressure {
+            reason: format!(
+                "system RAM low: {} MB available of {} MB ({}% used)",
+                mem.available_mb, mem.total_mb, mem.load_percent
+            ),
+            critical: mem.available_mb < 512 || mem.load_percent >= 97,
+        },
+    )
+}
