+
+struct FidelityCleanup<'a> {
+    db: &'a DbHandle,
+    input: &'a str,
+    cfg: &'a store::PipelineConfig,
+    profile: &'a str,
+    model: &'a str,
+    user_overrides: &'a str,
+    evidence: &'a str,
+    app_context: Option<&'a str>,
+    app: Option<&'a AppHandle>,
+    context_id: i64,
+    protected_terms: &'a [&'a str],
+    skip_model: bool,
+    allow_cache: bool,
+}
+
+async fn run_fidelity_cleanup(ctx: FidelityCleanup<'_>) -> (String, String, String) {
+    let english = ctx
+        .cfg
+        .transcription_language
+        .split(['-', '_'])
+        .next()
+        .is_some_and(|language| language.eq_ignore_ascii_case("en"));
+    let prepared = fidelity::prepare(ctx.input, ctx.protected_terms, english);
+    let normalize = |text: &str| {
+        if ctx.skip_model || ctx.cfg.has_style_instructions(ctx.profile) {
+            text.to_owned()
+        } else {
+            ensure_terminal_punctuation(text, ctx.profile, "light")
+        }
+    };
+    let overrides =
+        |text: &str| snippets::apply_cleanup_instruction_overrides(text, ctx.user_overrides);
+    let fallback = || {
+        (
+            overrides(&normalize(&prepared.text)),
+            String::new(),
+            String::new(),
+        )
+    };
+    log::debug!(
+        "pipeline: fidelity prepared edits={} input_chars={}",
+        prepared.edits,
+        ctx.input.chars().count()
+    );
+    if ctx.skip_model {
+        return fallback();
+    }
+    // A bounded validator refusing its own identity signals a resource cap.
+    // Preserve the transcript without making a model request in that case.
+    if fidelity::validate(&prepared.text, &prepared.text, ctx.protected_terms).is_none() {
+        log::warn!("pipeline: fidelity baseline exceeds validation budget");
+        return fallback();
+    }
+    let fingerprint = cache_digest(&serde_json::json!([
+        "fidelity-v1",
+        cleanup_context_fingerprint(ctx.cfg, ctx.user_overrides, ctx.app_context),
+        ctx.evidence,
+        ctx.protected_terms
+    ]));
+    let plan = cleanup_cache_plan_for_context(
+        &prepared.text,
+        ctx.profile,
+        "light",
+        ctx.user_overrides,
+        None,
+        Some(fingerprint),
+        Some(ctx.context_id),
+    );
+    let key = if ctx.allow_cache && ctx.cfg.cleanup_cache_enabled {
+        plan.key
+    } else {
+        String::new()
+    };
+    if !key.is_empty() {
+        if let Ok(Some(entry)) = db::cleanup_cache_get_active(ctx.db, &key) {
+            if let Some(text) =
+                fidelity::validate(&prepared.text, &entry.clean_text, ctx.protected_terms)
+            {
+                cache::touch_cleanup_cache_hit(ctx.db, &key, &entry);
+                record_lookup(true);
+                return (overrides(&text), key, format!("local/{}", ctx.model));
+            }
+            let _ = db::cleanup_cache_delete_by_key(ctx.db, &key);
+            log::warn!("pipeline: fidelity rejected cached edits");
+        }
+        record_lookup(false);
+    }
+    let custom_template = ctx.cfg.cleanup_override(ctx.profile);
+    let mut prompt = prompts::get_cleanup_prompt_with_alternate_and_evidence(
+        "local",
+        ctx.model,
+        ctx.profile,
+        "light",
+        ctx.user_overrides,
+        ctx.evidence,
+        ctx.app_context,
+        &prepared.text,
+        custom_template.as_deref(),
+        None,
+    );
+    prompt.push_str("\n\nSpoken formatting and supported corrections have already been processed. Preserve the resulting symbols, identifiers, line breaks, and all remaining words. Output only the text with punctuation and capitalization edits.");
+    let started = std::time::Instant::now();
+    let outcome = async {
+        #[cfg(any(test, debug_assertions))]
+        if let Some(result) =
+            crate::testing::resolve_provider_fixture("cleanup", "local", ctx.model)
+        {
+            return result;
+        }
+        let app = ctx
+            .app
+            .ok_or_else(|| anyhow::anyhow!("Local cleanup runtime unavailable"))?;
+        app.state::<crate::local_llm::LocalLlmManager>()
+            .inner()
+            .clone()
+            .cleanup_once_with_prompt(
+                app,
+                ctx.model,
+                &prepared.text,
+                &prompt,
+                prompts::cleanup_max_output_tokens("light", &prepared.text),
+            )
+            .await
+    }
+    .await;
+    record_provider_duration(started.elapsed());
+    let cleaned = match outcome {
+        Ok(text) => text,
+        Err(_) => {
+            log::warn!("pipeline: fidelity local request failed, preserving transcript without model escalation");
+            return fallback();
+        }
+    };
+    let Some(validated) = fidelity::validate(&prepared.text, &cleaned, ctx.protected_terms) else {
+        log::warn!("pipeline: fidelity rejected unsupported model edits without retry");
+        return fallback();
+    };
+    let normalized = normalize(&validated);
+    let Some(validated) = fidelity::validate(&prepared.text, &normalized, ctx.protected_terms)
+    else {
+        log::warn!("pipeline: fidelity rejected postprocessing edits");
+        return fallback();
+    };
+    if !key.is_empty() {
+        let expires = sqlite_utc_plus(db::CLEANUP_CACHE_IDLE_DAYS);
+        let _ = db::cleanup_cache_insert_if(
+            ctx.db,
+            &key,
+            &validated,
+            &expires,
+            plan.has_snippets,
+            || {
+                ctx.app.map_or(ctx.cfg.cleanup_cache_enabled, |app| {
+                    store::settings_handle(app).is_ok_and(|settings| {
+                        settings
+                            .get(store::CLEANUP_CACHE_ENABLED)
+                            .and_then(|value| value.as_bool())
+                            .unwrap_or(true)
+                    })
+                })
+            },
+        );
+    }
+    (overrides(&validated), key, format!("local/{}", ctx.model))
+}
